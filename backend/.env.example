DATABASE_URL=postgresql://user:password@localhost:5432/gesportium
# Opcional: BD separada para pytest (misma instancia Postgres, otra base),
# para que los tests nunca compartan datos con el servidor de desarrollo.
# Si se omite, conftest.py usa DATABASE_URL con "_test" añadido al nombre
# de la base (p. ej. gesportium -> gesportium_test) y la crea sola si el
# usuario de BD tiene privilegio CREATEDB.
# TEST_DATABASE_URL=postgresql://user:password@localhost:5432/gesportium_test
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
TOTEM_API_KEY=change-me
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
